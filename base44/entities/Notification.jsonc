{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "follow",
        "rating",
        "comment"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "rating_value": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "actor_id"
  ]
}