{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "unique": true
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "maxLength": 150
    },
    "profile_picture": {
      "type": "string"
    },
    "is_pro": {
      "type": "boolean",
      "default": false
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "favorite_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followed_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}