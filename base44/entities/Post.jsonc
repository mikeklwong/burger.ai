{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "maxLength": 300
    },
    "category": {
      "type": "string",
      "enum": [
        "Streetwear",
        "Old Money",
        "Business Casual",
        "Formal",
        "Historical"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style_description": {
      "type": "string"
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "rating_burger": {
      "type": "number",
      "default": 0
    },
    "rating_mid": {
      "type": "number",
      "default": 0
    },
    "rating_fire": {
      "type": "number",
      "default": 0
    },
    "rating_tuff": {
      "type": "number",
      "default": 0
    },
    "rating_iconic": {
      "type": "number",
      "default": 0
    },
    "rating_sum": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "avg_score": {
      "type": "number",
      "default": 0
    },
    "top_word": {
      "type": "string"
    }
  },
  "required": [
    "author_id",
    "image_url",
    "category"
  ]
}